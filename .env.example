# Copy to .env (which is git-ignored) and fill in to publish the Docker image.
# Prefer a Docker Hub *access token* (Account Settings -> Security) over your
# real password — tokens are revocable and scoped.
DOCKER_LOGIN=your-dockerhub-username
DOCKER_PAS=your-dockerhub-access-token

# For npm publishing via CI, add NPM_TOKEN as a GitHub Actions secret instead
# (Settings -> Secrets and variables -> Actions). It does not belong in .env.
