# Build context for docker/Dockerfile.my-shell (make my_shell + update): ship the
# sources, the checked-out submodules and the test scripts, but never host
# build artifacts or git internals. BuildKit prefers this file over the
# repo-root .dockerignore for this specific Dockerfile.
.git
**/.git
build/
vendor/libft/build
vendor/libft/build-*
**/*.o
**/*.a
npm/node_modules/
tests/outfiles/
tests/mini_outfiles/
tests/bash_outfiles/
*.log

# Never ship developer secrets into an image: these Dockerfiles COPY the
# whole context, and a .env sitting in a working tree is exactly the kind of
# file that ends up in a published layer.
.env
.env.*
*.pem
*.key
id_rsa*
