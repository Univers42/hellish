# Build context for docker/Dockerfile.static. Same rule as the from-source
# image: ship sources + checked-out submodules, never host build artifacts.
# Host objects leaking in would be worse here than elsewhere -- they are glibc
# objects, and the whole point of this image is a musl-static link.
.git
**/.git
build/
vendor/libft/build
vendor/libft/build-*
**/*.o
**/*.a
npm/node_modules/
tests/outfiles/
tests/mini_outfiles/
tests/bash_outfiles/
dist/
*.log

# Never ship developer secrets into an image: these Dockerfiles COPY the
# whole context, and a .env sitting in a working tree is exactly the kind of
# file that ends up in a published layer.
.env
.env.*
*.pem
*.key
id_rsa*
