*.a
*/*.a
*/*.o
*.o
.vscode
temp/
build/
out.dot
tests/results.log
tests/bench_results.txt
tests/agnostic_results.tsv
.claude/

# secrets / credentials — never commit
.env
.env.*
!.env.example

# bench harness: vendored suites + generated artifacts (reports ARE tracked)
bench/suites/
bench/.artifacts/
bench/.bin/
bench/workloads/

# python bytecode from bench/lib tooling
__pycache__/
*.pyc

# hostile-filename glob fixtures -- generated by tests/gen_fixtures.sh at
# harness startup (NTFS cannot represent these names; never track them)
tests/&&
tests/\*
tests/glob-zoo/a\*b
tests/glob-zoo/symbols/!
tests/glob-zoo/symbols/\*
tests/glob-zoo/symbols/\?
tests/glob-zoo/symbols/\[
tests/glob-zoo/symbols/]
tests/glob-zoo/symbols/^
tests/glob-zoo/symbols/\\\*
tests/glob-zoo/symbols/\\\?
tests/[]
tests/glob-zoo/tab	file
