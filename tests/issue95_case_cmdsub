y=$(case abc in a*) echo A ;; *) echo B ;; esac); echo "result=[$y]"
n=$(case "5" in ''|*[!0-9]*) echo no ;; *) echo yes ;; esac); echo "n=$n"
n=$(case "x9" in ''|*[!0-9]*) echo no ;; *) echo yes ;; esac); echo "n=$n"
x=$(case q in (a) echo A ;; (q) echo Q ;; esac); echo "x=$x"
z=$(case foo in f*) case bar in b*) echo nested ;; esac ;; esac); echo "z=$z"
w=$(case a in a) (echo sub) ;; esac); echo "w=$w"
v=$(case b in a) echo A ;; b) echo B ;; c) echo C ;; esac); echo "v=$v"
echo before; t=$(case t in t) echo T ;; esac); echo "after=$t"
u=$(case ")" in ")") echo paren ;; *) echo other ;; esac); echo "u=$u"
p=$(case x in y) echo no ;; esac; echo done); echo "p=$p"
q=$(v=case; echo "$v"); echo "q=$q"
r=$(echo case; echo esac); echo "r=$r"
s=$(case m in m) echo one; echo two ;; esac); echo "s=$s"
