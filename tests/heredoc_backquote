eval $'cat << EOF\na=`echo hi`\nEOF'
eval $'cat << EOF\n`echo one` and `echo two`\nEOF'
eval $'cat << EOF\nmixed: `echo bq` $(echo dollar) $((1+2))\nEOF'
x=42; eval $'cat << EOF\ndollar-escape: `echo \\$x`\nEOF'
eval $'cat << EOF\nnested: `echo "$(echo in)"`\nEOF'
eval $'cat << \'EOF\'\nquoted: `echo no`\nEOF'
eval $'cat << "EOF"\ndquoted: `echo no`\nEOF'
eval $'cat <<- EOF\n\t`echo tabbed`\n\tEOF'
eval $'cat << EOF > hb_out\n`echo to-file`\nEOF'; cat hb_out
as_echo='printf %s\n'; as_tr_cpp="eval sed 'y%*abcdefghijklmnopqrstuvwxyz%PABCDEFGHIJKLMNOPQRSTUVWXYZ%;s%[^_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789]%_%g'"; ac_header=sys/stat.h; eval $'cat << _ACEOF\n#define `$as_echo "HAVE_$ac_header" | $as_tr_cpp` 1\n_ACEOF'
f() { echo from-func; }; eval $'cat << EOF\nfunc: `f`\nEOF'
eval $'cat << EOF\nempty: [`true`] [`echo`]\nEOF'
eval $'cat << EOF\ntrailing: [`printf "a\\n\\n\\n"`]\nEOF'
eval $'cat << EOF\nbs-bq literal: \\`echo kept\\`\nEOF'
eval $'cat << EOF\ntwo: <`echo A`-mid-`echo B`>\nEOF'
eval $'cat << EOF\npipe: `echo piped | tr a-z A-Z`\nEOF'
eval $'cat << EOF | tr a-z A-Z\nstage: `echo lower`\nEOF'
eval $'v=`cat << EOF\ninner: $(echo dollar-inside)\nEOF\n`; echo "$v"'
eval $'for h in a.h b/c.h; do cat << EOF\n`echo "HAVE_$h" | tr a-z/. A-Z__`\nEOF\ndone'
