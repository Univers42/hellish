#!/bin/bash

# ---- environment isolation -------------------------------------------------
# Both sides of every comparison must see the same environment, and the
# DEVELOPER's environment is not neutral. This suite diffs hellish against
# bash byte-for-byte, so any variable that changes bash's output changes the
# verdict -- and the people most likely to run it are the people who use
# hellish as their daily shell, i.e. the people whose rc exports the most.
#
# Real case: a `~/.hellishrc` framework exporting HISTTIMEFORMAT='%F %T '
# made `history` print timestamps on the bash side and not on hellish's, and
# 12 issue42_history_opts cases "failed" against code that was correct. The
# same class of leak (HOME, so the rc itself loads) breaks the pty suite.
#
# So: unset the variables that steer the constructs under test, rather than
# scrubbing the whole environment -- PATH, TERM and the locale still have to
# work. Add to this list when a new category turns out to be env-sensitive.
unset HISTTIMEFORMAT HISTCONTROL HISTSIZE HISTFILE HISTFILESIZE HISTIGNORE
unset ENV BASH_ENV CDPATH IFS GLOBIGNORE PROMPT_COMMAND
export LC_ALL=C

# Parse arguments:
VERBOSE=0
test_lists=()
for arg in "$@"; do
    if [[ "$arg" == "-v" || "$arg" == "--verbose" ]]; then
        VERBOSE=1
    else
        test_lists+=("$arg")
    fi
done

if [[ ${#test_lists[@]} -eq 0 ]]; then
    test_lists=(
        "globbing" "crazy1" "arith" "edge_cases" "dylan_exec"
        "builtins" "compound" "crazy2" "var" "pipe" "sq" "dq" "redir"
        "pipes" "redirects" "extras" "echo_edge_cases" "advanced_edge_cases"
        "regress_hellish" "regress_combos" "cd_posix" "torture"
        "alias_posix" "builtins_posix" "cmd_not_found_handle" "pattern_class"
        "issue12_export" "export_attr" "wait_reports" "issue14_dollar0"
        "issue15_colon_question" "issue11_cmdsub_brace"
        "issue8_set_options"
        "issue18_job_numbers"
        "issue27_job_pgrp"
        "issue42_history_opts"
        "issue13_bg_pid"
        "issue17_signal_report"
        "issue16_net_redir"
        "redir_multi_fd"
        "dquote_brace_nest"
        "glob_collate"
        "special_builtin_abort"
        "readonly_status"
        "fatal_status"
        "job_label"
        "help_builtin"
        "printf_length"
        "array_subscript" "declare_quoting" "procsub_assign"
        "longtail"
        "issue95_case_cmdsub"
        "issue96_trap_func"
        "issue105_expansions"
        "assign_shaped_words"
        "funcbody"
    )
fi

BOLD="\e[1m"
YELLOW="\033[0;33m"
GREY="\033[38;5;244m"
PURPLE="\033[0;35m"
BLUE="\033[0;36m"
RED="\e[0;31m"
GREEN="\e[0;32m"
END="\033[0m"

TEST_DIR="$(pwd)"
bash "$TEST_DIR/gen_fixtures.sh"
MINISHELL_PATH="${HELLISH_BIN:-$(cd .. && pwd)/build/bin/hellish}"
if [[ ! -f "$MINISHELL_PATH" && -f "$MINISHELL_PATH.exe" ]]; then
    MINISHELL_PATH="$MINISHELL_PATH.exe"
fi
if [[ ! -f "$MINISHELL_PATH" ]]; then
    echo -e "${RED}Error: hellish not found at $MINISHELL_PATH${END}"
    exit 1
fi

# The suite is a DIFF against `bash --posix`, so the bash in PATH is not a
# detail -- it is the definition of "correct". bash changes POSIX-visible
# behaviour between minor releases (5.1 vs 5.3 disagree on ~35 of these cases:
# printf's status on numeric overflow, umask symbolic validation, cd's status
# on too many operands, whether `.*` matches . and ..), so an older bash reports
# failures that are really bash-version drift, not shell bugs. CI pins 5.3.9 for
# exactly this reason; without the same pin here, `make test` and CI disagree.
#
# Prefer a locally built pinned oracle when one exists (`make oracle` puts it
# there), otherwise use PATH and say plainly what is about to happen.
ORACLE_HOME="${HELLISH_ORACLE:-$HOME/bash-5.3.9}"
if [[ -x "$ORACLE_HOME/bin/bash" ]]; then
    PATH="$ORACLE_HOME/bin:$PATH"
    export PATH
fi
ORACLE_VERSION="$(bash --version 2>/dev/null | head -1 | sed 's/.*version \([0-9.]*\).*/\1/')"
case "$ORACLE_VERSION" in
    5.3*) ;;
    *)
        printf "${RED}⚠  oracle drift: this suite diffs against bash %s, but the\n" \
            "${ORACLE_VERSION:-unknown}"
        printf "   pinned golden oracle is 5.3.x. Expect phantom failures that are\n"
        printf "   bash-version differences, not hellish bugs.\n"
        printf "   Build the pinned oracle once:  make oracle${END}\n\n"
        ;;
esac

chmod 000 "$TEST_DIR/test_files/invalid_permission" 2>/dev/null
mkdir -p "$TEST_DIR/outfiles" "$TEST_DIR/mini_outfiles" "$TEST_DIR/bash_outfiles"

printf "${RED}🔥 Parallel Test Harness starting 🔥${END}\n"

RUN_DIR="$(mktemp -d /tmp/sh42_tester_XXXXXX)"

# A named file that is not there is FATAL, not a warning.
#
# test_lists is hand-maintained, so a rename or a typo used to drop a whole
# case file on the floor and print one yellow line in the middle of a run
# that then said "ALL N TESTS PASSED" -- a smaller N nobody was watching.
# The pty runner discovers its tests for exactly this reason and says so;
# this suite cannot discover (tests/ holds fixtures, scripts and outputs
# next to the case files), so it fails loudly instead.
rm -f "$RUN_DIR/queue.txt"
TOTAL_TESTS=0
MISSING=()
for tf in "${test_lists[@]}"; do
    if [[ -f "$tf" ]]; then
        while IFS= read -r teste || [[ -n "$teste" ]]; do
            [[ -z "$teste" ]] && continue
            ((TOTAL_TESTS++))
            echo "$TOTAL_TESTS|||$tf|||$teste" >> "$RUN_DIR/queue.txt"
        done < "$tf"
    else
        MISSING+=("$tf")
    fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
    printf "${RED}✗ case file(s) named in test_lists but not on disk:${END}\n" >&2
    printf "   %s\n" "${MISSING[@]}" >&2
    printf "${RED}   Refusing to report a pass on a suite that shrank.${END}\n" >&2
    rm -rf "$RUN_DIR"
    exit 1
fi

if [[ $TOTAL_TESTS -eq 0 ]]; then
    echo "No tests found."
    exit 0
fi

# Worker script
cat << 'EOF_WORKER' > "$RUN_DIR/worker.sh"
#!/bin/bash
index=$1
testfile=$2
teste=$3
VERBOSE=$4
TEST_DIR=$5
MINISHELL_PATH=$6
RUN_DIR=$7

workdir="$RUN_DIR/job_$index"
mkdir -p "$workdir/outfiles" "$workdir/mini_outfiles" "$workdir/bash_outfiles"
cp -a "$TEST_DIR/test_files" "$workdir/" 2>/dev/null || true
cd "$workdir" || exit 1

m_out=$(mktemp) m_err=$(mktemp)
# Pipe stdout through cat so capture blocks until every writer closes the fd,
# including async process-substitution children (e.g. > >(awk ...)). Without
# this, an orphaned writer can flush after the shell exits and be missed,
# making such tests race. PIPESTATUS[0] keeps the shell's real exit status.
"$MINISHELL_PATH" -c "$teste" 2>"$m_err" | cat >"$m_out"
m_ext=${PIPESTATUS[0]}

m_out_filtered=$(cat "$m_out" | perl -pe 's/\e\[[0-9;]*[A-Za-z]//g' | grep -vE '^[[:space:]]*❯' | grep -v '^exit$')
m_err_filtered=$(cat "$m_err" | perl -pe 's/\e\[[0-9;]*[A-Za-z]//g' | grep -o '[^:]*$' | head -n1 || true)

cp ./outfiles/* ./mini_outfiles/ 2>/dev/null || true
rm -rf ./outfiles/*

b_out=$(mktemp) b_err=$(mktemp)
bash --posix -c "$teste" 2>"$b_err" | cat >"$b_out"
b_ext=${PIPESTATUS[0]}

b_out_filtered=$(cat "$b_out" | perl -pe 's/\e\[[0-9;]*[A-Za-z]//g' | grep -vE '^[[:space:]]*❯' | grep -v '^exit$')
b_err_filtered=$(cat "$b_err" | perl -pe 's/\e\[[0-9;]*[A-Za-z]//g' | grep -o '[^:]*$' | head -n1 || true)

cp ./outfiles/* ./bash_outfiles/ 2>/dev/null || true

diff_out=$(diff --brief ./mini_outfiles ./bash_outfiles 2>&1)

status="FAIL"
if [[ "$m_out_filtered" == "$b_out_filtered" && "$m_ext" == "$b_ext" && -z "$diff_out" ]]; then
    status="PASS"
fi

result_file="$RUN_DIR/res_${index}.out"
if [[ "$status" == "PASS" ]]; then
    echo "PASS" > "$result_file"
else
    echo "FAIL" > "$result_file"
    echo "File: $testfile" >> "$result_file"
    echo "Command: $teste" >> "$result_file"
    if [[ -n "$diff_out" ]]; then
        echo "Dir Diff: $diff_out" >> "$result_file"
        echo "Mini outfiles: $(find ./mini_outfiles -type f 2>/dev/null | xargs -r basename -a | tr '\n' ' ')" >> "$result_file"
        echo "Bash outfiles: $(find ./bash_outfiles -type f 2>/dev/null | xargs -r basename -a | tr '\n' ' ')" >> "$result_file"
    fi
    if [[ "$m_out_filtered" != "$b_out_filtered" ]]; then
        echo "=====================================" >> "$result_file"
        echo "Mini output: ($m_out_filtered)" >> "$result_file"
        echo "-------------------------------------" >> "$result_file"
        echo "Bash output: ($b_out_filtered)" >> "$result_file"
        echo "=====================================" >> "$result_file"
    fi
    if [[ "$m_ext" != "$b_ext" ]]; then
        echo "Mini exit code: $m_ext" >> "$result_file"
        echo "Bash exit code: $b_ext" >> "$result_file"
    fi
    if [[ "$VERBOSE" == "1" && "$m_err_filtered" != "$b_err_filtered" ]]; then
        echo "Mini error msg: ($m_err_filtered)" >> "$result_file"
        echo "Bash error msg: ($b_err_filtered)" >> "$result_file"
    fi
fi

rm -f "$m_out" "$m_err" "$b_out" "$b_err"
rm -rf "$workdir" # Cleanup to save space
EOF_WORKER

chmod +x "$RUN_DIR/worker.sh"

export RUN_DIR
export MINISHELL_PATH
export TEST_DIR
export VERBOSE

# Tracker
(
    while true; do
        cnt=$(find "$RUN_DIR" -maxdepth 1 -name "res_*.out" 2>/dev/null | wc -l)
        printf "\r\033[KProgress: %d / %d tests completed..." "$cnt" "$TOTAL_TESTS"
        if [ "$cnt" -eq "$TOTAL_TESTS" ]; then
            break
        fi
        sleep 0.5
    done
    printf "\n"
) &
TRACKER_PID=$!

# Dispatch using xargs with null terminators
while IFS= read -r line; do
    index="${line%%|||*}"
    rest="${line#*|||}"
    file="${rest%%|||*}"
    cmd="${rest#*|||}"
    printf "%s\0%s\0%s\0%s\0%s\0%s\0%s\0" "$index" "$file" "$cmd" "$VERBOSE" "$TEST_DIR" "$MINISHELL_PATH" "$RUN_DIR"
done < "$RUN_DIR/queue.txt" | xargs -0 -P 16 -n 7 bash "$RUN_DIR/worker.sh"

wait "$TRACKER_PID" 2>/dev/null

echo -e "\n${BOLD}${PURPLE}================ SUMMARY =================${END}"

FAILS=0
for ((i=1; i<=TOTAL_TESTS; i++)); do
    f="$RUN_DIR/res_${i}.out"
    if [[ -f "$f" ]]; then
        status=$(head -n 1 "$f")
        if [[ "$status" == "FAIL" ]]; then
            ((FAILS++))
            echo -e "${RED}❌ TEST $i FAILED${END}"
            tail -n +2 "$f"
            echo ""
        fi
    fi
done

PASSED=$((TOTAL_TESTS - FAILS))

if [[ $FAILS -eq 0 ]]; then
    printf "${GREEN}${BOLD}🎊 ALL $TOTAL_TESTS TESTS PASSED! 🎊${END}\n"
    rm -rf "$RUN_DIR"
    exit 0
else
    printf "${RED}${BOLD}😭 $FAILS FAILED OUT OF $TOTAL_TESTS TESTS 😭${END}\n"
    # Keep RUN_DIR around for debugging if there are failures
    echo "Failure details saved in temp file (not cleaned up): $RUN_DIR"
    exit 1
fi
