# tests/fixtures/frontend.hellishrc -- the SHAPE of a real user configuration.
#
# The interactive gates (prompt_drift_matrix_test.py, prompt_latency_test.py,
# prompt_syscall_budget_test.py) copy this file into a throwaway $HOME and
# start an interactive shell against it. Every element here was implicated
# in a field report and is absent from the built-in default prompt, which
# is why none of the older pty tests could see the bugs:
#
#   - a coloured two-row PS1 with \[ \] width guards and self-spacing badges
#   - a COLOURED RPROMPT (the zsh spelling, so it carries its own \001/\002
#     pairs once rendered -- the nested-marker case)
#   - precmd hooks AND a PROMPT_COMMAND, so every prompt dispatches three
#     hook functions
#   - multi-line history recall
#   - the whole HIST* family
#
# Keep it hellish-only. The bash twin used as the latency control is
# generated by the test from the same PS1 text.
PS1='\[\e[38;5;238m\]╭─\[\e[0m\] \[\e[1;38;5;117m\]\w\[\e[0m\]\[\e[38;5;244m\]\g\[\e[0m\]\[\e[38;5;203m\]\S\[\e[0m\]\n\[\e[38;5;238m\]╰─\[\e[0m\] \[\e[38;5;114m\]❯\[\e[0m\] '
RPROMPT='%F{238}%D{%H:%M}%f'

fx_precmd_a() { FX_A=$((${FX_A:-0} + 1)); }
fx_precmd_b() { FX_B=$((${FX_B:-0} + 1)); }
HELLISH_PRECMD_FUNCS='fx_precmd_a fx_precmd_b'
fx_prompt_command() { FX_PC=$((${FX_PC:-0} + 1)); }
PROMPT_COMMAND='fx_prompt_command'

pretty on multiline-history 2>/dev/null

HISTFILE="$HOME/.fx_history"
HISTSIZE=2000
HISTFILESIZE=2000
HISTCONTROL=ignoredups:ignorespace:erasedups
HISTIGNORE='ls:cd:exit'
HISTTIMEFORMAT='%F %T '
